@page
@model IndexModel
@{
    ViewData["Title"] = "User Login";
}

<div style="display: flex; justify-content: center; align-items: center; min-height: 70vh;">
    <div style="border: 1px solid #ccc; padding: 30px; border-radius: 8px; width: 350px;">
        <h3 style="text-align: center; margin-bottom: 20px;">User Login</h3>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div style="color: red; margin-bottom: 15px; text-align: center;">
                @Model.ErrorMessage
            </div>
        }

        <form method="post">
            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px;">Username</label>
                <input type="text" asp-for="Username" style="width: 100%; padding: 8px; box-sizing: border-box;" required />
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 5px;">Password</label>
                <input type="password" asp-for="Password" style="width: 100%; padding: 8px; box-sizing: border-box;" required />
            </div>

            <button type="submit" style="width: 100%; padding: 10px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">
                Login
            </button>
        </form>
    </div>
</div>