@page
@model DepartmentTransferModel
@{
    ViewData["Title"] = "Department Transfer";
}

<div style="max-width: 1000px; margin: 30px auto; font-family: sans-serif;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2>Department Transfer & Live Kapan Receive</h2>
        <a asp-page="/Dashboard" style="text-decoration: none; color: #007bff; font-weight: bold;">← Back to Dashboard</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div style="background-color: #d4edda; color: #155724; padding: 10px; border-radius: 4px; margin-bottom: 15px;">@Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div style="background-color: #f8d7da; color: #721c24; padding: 10px; border-radius: 4px; margin-bottom: 15px;">@Model.ErrorMessage</div>
    }

    <!-- Send Kapan Form -->
    <div style="border: 1px solid #ccc; padding: 20px; border-radius: 6px; margin-bottom: 30px; background-color: #fdfdfd;">
        <h4 style="margin-top: 0; color: #0056b3;">Send Packet to Another Department (F1)</h4>
        <form method="post" asp-page-handler="Send" style="display: grid; grid-template-columns: 2fr 1.5fr 1fr; gap: 15px; align-items: end;">
            <div>
                <label style="display: block; font-size: 13px; margin-bottom: 4px;">Select Packet</label>
                <select asp-for="SelectedKPID" asp-items="Model.AvailablePackets" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;" required>
                    <option value="">-- Choose Packet --</option>
                </select>
            </div>
            <div>
                <label style="display: block; font-size: 13px; margin-bottom: 4px;">Transfer To Department</label>
                <select asp-for="ToDepartmentID" asp-items="Model.Departments" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;" required>
                    <option value="">-- Target Department --</option>
                </select>
            </div>
            <div>
                <button type="submit" style="width: 100%; padding: 9px; background-color: #007bff; color: white; font-weight: bold; border: none; border-radius: 4px; cursor: pointer;">Send Packet</button>
            </div>
        </form>
    </div>

    <!-- Live Pending Receive Panel -->
    <h4 style="color: #856404;">Pending Department Receives (F2 - Accept Incoming Packets)</h4>
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 30px; font-size: 14px;">
        <thead>
            <tr style="background-color: #fff3cd; text-align: left;">
                <th style="padding: 10px; border: 1px solid #ddd;">Packet</th>
                <th style="padding: 10px; border: 1px solid #ddd;">From Dept</th>
                <th style="padding: 10px; border: 1px solid #ddd;">To Dept</th>
                <th style="padding: 10px; border: 1px solid #ddd; text-align: right;">Pcs</th>
                <th style="padding: 10px; border: 1px solid #ddd; text-align: right;">Carats</th>
                <th style="padding: 10px; border: 1px solid #ddd;">Sent Time</th>
                <th style="padding: 10px; border: 1px solid #ddd; text-align: center;">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PendingTransfers.Count == 0)
            {
                <tr><td colspan="7" style="padding: 15px; text-align: center; color: #888; border: 1px solid #ddd;">No pending transfers to receive.</td></tr>
            }
            else
            {
                @foreach (var t in Model.PendingTransfers)
                {
                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">@t.DisplayName</td>
                        <td style="padding: 8px; border: 1px solid #ddd;">@t.FromDept</td>
                        <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold; color: #0056b3;">→ @t.ToDept</td>
                        <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">@t.Pieces</td>
                        <td style="padding: 8px; border: 1px solid #ddd; text-align: right; font-weight: bold;">@t.Carats.ToString("0.000")</td>
                        <td style="padding: 8px; border: 1px solid #ddd;">@t.TransferDate.ToString("dd-MMM HH:mm")</td>
                        <td style="padding: 8px; border: 1px solid #ddd; text-align: center;">
                            <form method="post" asp-page-handler="Receive" style="margin: 0;">
                                <input type="hidden" name="transId" value="@t.DepTransID" />
                                <input type="hidden" name="kpid" value="@t.KPID" />
                                <button type="submit" style="background-color: #28a745; color: white; border: none; padding: 5px 12px; border-radius: 3px; font-weight: bold; cursor: pointer;">Accept / Receive</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- History -->
    <h4>Completed Department Transfers</h4>
    <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
        <thead>
            <tr style="background-color: #f1f1f1; text-align: left;">
                <th style="padding: 8px; border: 1px solid #ddd;">Packet</th>
                <th style="padding: 8px; border: 1px solid #ddd;">From Dept</th>
                <th style="padding: 8px; border: 1px solid #ddd;">To Dept</th>
                <th style="padding: 8px; border: 1px solid #ddd; text-align: right;">Pcs</th>
                <th style="padding: 8px; border: 1px solid #ddd; text-align: right;">Carats</th>
                <th style="padding: 8px; border: 1px solid #ddd;">Accepted On</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model.TransferHistory)
            {
                <tr>
                    <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">@h.DisplayName</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@h.FromDept</td>
                    <td style="padding: 8px; border: 1px solid #ddd; color: #28a745; font-weight: bold;">@h.ToDept</td>
                    <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">@h.Pieces</td>
                    <td style="padding: 8px; border: 1px solid #ddd; text-align: right;">@h.Carats.ToString("0.000")</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@h.AcceptDate?.ToString("dd-MMM-yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>