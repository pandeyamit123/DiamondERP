@page
@model EmployeeMasterModel
@{
    ViewData["Title"] = "Employee Master";
}

<div style="max-width: 850px; margin: 30px auto; font-family: sans-serif;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2>Employee Master</h2>
        <a asp-page="/Dashboard" style="text-decoration: none; color: #007bff; font-weight: bold;">← Back to Dashboard</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div style="background-color: #d4edda; color: #155724; padding: 10px; border-radius: 4px; margin-bottom: 15px;">
            @Model.Message
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div style="background-color: #f8d7da; color: #721c24; padding: 10px; border-radius: 4px; margin-bottom: 15px;">
            @Model.ErrorMessage
        </div>
    }

    <!-- Add/Edit Form -->
    <div style="border: 1px solid @(Model.IsEditing ? "#ffc107" : "#ccc"); padding: 18px; border-radius: 6px; margin-bottom: 25px; background-color: @(Model.IsEditing ? "#fffdf5" : "#fdfdfd");">
        <h4 style="margin-top: 0; color: @(Model.IsEditing ? "#856404" : "#333");">
            @(Model.IsEditing ? $"Edit Employee (ID: {Model.EditEmployeeId})" : "Add New Employee")
        </h4>

        <form method="post" asp-page-handler="@(Model.IsEditing ? "Update" : "Add")">
            @if (Model.IsEditing)
            {
                <input type="hidden" asp-for="EditEmployeeId" />
            }

            <div style="display: grid; grid-template-columns: 2fr 1.5fr 1.5fr auto; gap: 10px; align-items: end;">
                <div>
                    <label style="display: block; margin-bottom: 4px; font-size: 13px;">Employee Name</label>
                    <input type="text" asp-for="EmployeeName" placeholder="Enter name" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" required />
                </div>

                <div>
                    <label style="display: block; margin-bottom: 4px; font-size: 13px;">Department</label>
                    <select asp-for="DepartmentID" asp-items="Model.DepartmentList" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" required>
                        <option value="">-- Select --</option>
                    </select>
                </div>

                <div>
                    <label style="display: block; margin-bottom: 4px; font-size: 13px;">Contact No</label>
                    <input type="text" asp-for="ContactNo" placeholder="Mobile / Phone" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;" />
                </div>

                <div>
                    @if (Model.IsEditing)
                    {
                        <div style="display: flex; gap: 6px;">
                            <button type="submit" style="padding: 8px 16px; background-color: #ffc107; color: #212529; font-weight: bold; border: none; border-radius: 4px; cursor: pointer;">Update</button>
                            <a asp-page="/EmployeeMaster" style="padding: 8px 12px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 4px;">Cancel</a>
                        </div>
                    }
                    else
                    {
                        <button type="submit" style="padding: 8px 18px; background-color: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer;">Save</button>
                    }
                </div>
            </div>
        </form>
    </div>

    <!-- Employee Table -->
    <h4>Existing Employees</h4>
    <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
        <thead>
            <tr style="background-color: #f1f1f1; text-align: left;">
                <th style="padding: 10px; border: 1px solid #ddd; width: 60px;">ID</th>
                <th style="padding: 10px; border: 1px solid #ddd;">Name</th>
                <th style="padding: 10px; border: 1px solid #ddd;">Department</th>
                <th style="padding: 10px; border: 1px solid #ddd;">Contact</th>
                <th style="padding: 10px; border: 1px solid #ddd; width: 140px; text-align: center;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Employees.Count == 0)
            {
                <tr>
                    <td colspan="5" style="padding: 15px; text-align: center; color: #888; border: 1px solid #ddd;">No employees found.</td>
                </tr>
            }
            else
            {
                @foreach (var emp in Model.Employees)
                {
                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">@emp.EmployeeID</td>
                        <td style="padding: 8px; border: 1px solid #ddd; font-weight: 500;">@emp.EmployeeName</td>
                        <td style="padding: 8px; border: 1px solid #ddd;">@emp.DepartmentName</td>
                        <td style="padding: 8px; border: 1px solid #ddd;">@emp.ContactNo</td>
                        <td style="padding: 8px; border: 1px solid #ddd; text-align: center;">
                            <div style="display: flex; gap: 6px; justify-content: center;">
                                <a asp-page="/EmployeeMaster" asp-route-editId="@emp.EmployeeID" style="background-color: #ffc107; color: #212529; text-decoration: none; padding: 4px 8px; border-radius: 3px; font-size: 12px; font-weight: bold;">Edit</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@emp.EmployeeID" onsubmit="return confirm('Delete employee @emp.EmployeeName?');" style="margin: 0;">
                                    <button type="submit" style="background-color: #dc3545; color: white; border: none; padding: 4px 8px; border-radius: 3px; font-size: 12px; cursor: pointer;">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>